# npm start y npm run dev cargan .env si existe.
PORT=3000
# Opcional: dirección accesible desde otro dispositivo para los QR.
# Ejemplo en la misma Wi-Fi: http://192.168.1.20:3000
# Ejemplo con túnel: https://tu-tienda.ngrok-free.app
# Sin este valor, se usa la dirección con la que se abrió la tienda.
PUBLIC_BASE_URL=

# QM5/QM6: Access Token de la aplicación/cuenta de prueba de MercadoPago.
# Se usa solamente en el backend. No pegarlo en el frontend ni en Git.
MP_ACCESS_TOKEN=
# standard usa init_point; sandbox usa sandbox_init_point explícitamente.
# Elegir sandbox no convierte una cuenta real en cuenta de prueba.
MP_CHECKOUT_MODE=standard
# Para checkout, PUBLIC_BASE_URL debe ser un origen HTTPS público, sin rutas.
# Ejemplo: https://tu-tienda.ngrok-free.app
